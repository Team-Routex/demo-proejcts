# Raft Framework Configuration (development defaults)
RAFT_DEBUG=true
RAFT_SECRET_KEY=dev-only-change-me-to-a-long-random-secret
RAFT_HOST=127.0.0.1
RAFT_PORT=8000
RAFT_ALLOWED_HOSTS=*
RAFT_CORS_ALLOWED_ORIGINS=*
RAFT_LOG_LEVEL=info

# OpenAPI / Swagger / ReDoc
RAFT_OPENAPI_DOCS_ENABLED=true
RAFT_OPENAPI_DOCS_VISIBILITY=public
# Protect docs with HTTP Basic (set BOTH username and password):
# RAFT_OPENAPI_DOCS_USERNAME=docs
# RAFT_OPENAPI_DOCS_PASSWORD=change-me
# Production: turn docs off
# RAFT_OPENAPI_DOCS_ENABLED=false

# Sessions: memory (default) or redis
RAFT_SESSION_BACKEND=memory
RAFT_SESSION_MAX_AGE=3600
# RAFT_SESSION_COOKIE_SECURE=true
# RAFT_REDIS_URL=redis://localhost:6379/0
# RAFT_REDIS_PREFIX=raft:

# JWT (optional RAFT_JWT_SECRET; otherwise uses RAFT_SECRET_KEY)
# RAFT_JWT_SECRET=another-long-random-secret-at-least-32-bytes
RAFT_JWT_ALGORITHM=HS256
# Rate limiting (opt-in; use redis backend with multiple workers)
# RAFT_RATE_LIMIT_ENABLED=true
# RAFT_RATE_LIMIT_REQUESTS=100
# RAFT_RATE_LIMIT_WINDOW_SECONDS=60
# RAFT_RATE_LIMIT_BACKEND=memory
